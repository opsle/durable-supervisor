    "model polling prohibited",
    "Claude disabled",
    "review off"
  ],
  "requirement_ids": [
    "DS-038",
    "DS-058",
    "DS-067"
  ],
  "route_hint": "deterministic",
  "deterministic_command": [
    "node",
    "./bin/opsle.js",
    "validate"
  ],
  "verification_command": null,
  "expects_changes": false,
  "timeout_seconds": 30
}
